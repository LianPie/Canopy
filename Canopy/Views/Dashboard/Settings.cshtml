@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer _localizer
@{
    Layout = "~/views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = _localizer["SettingsTitle"];
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}

<div class="d-flex flex-column flex-column-fluid">
    <!-- Toolbar / Page Title -->
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                    @_localizer["SettingsTitle"]
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a href="/dashboard" class="text-muted text-hover-primary">@_localizer["Dashboard"]</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-dark">@_localizer["SettingsTitle"]</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Page Content -->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-xxl">
            <div class="card card-flush">

                <!-- Settings Header Tabs -->
                <div class="card-header border-0 pt-6">
                    <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
                        <li class="nav-item">
                            <a class="nav-link text-active-primary ms-0 me-10 active" data-bs-toggle="tab" href="#kt_settings_language">
                                <i class="ki-duotone ki-geolocation fs-2 me-2">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                @_localizer["LanguageAndRegion"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-active-primary me-10 disabled" href="#" tabindex="-1" aria-disabled="true">
                                <i class="ki-duotone ki-paintbucket fs-2 me-2">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                @_localizer["Appearance"] <span class="badge badge-light-primary fs-8 ms-2">@_localizer["ComingSoon"]</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="separator"></div>

                <!-- Settings Tab Content -->
                <div class="card-body pt-8">
                    <div class="tab-content" id="myTabContent">

                        <!-- Language Tab -->
                        <div class="tab-pane fade show active" id="kt_settings_language" role="tabpanel">

                            <div class="mb-8">
                                <h3 class="fw-bold text-gray-900 mb-2">@_localizer["SelectLanguageHeading"]</h3>
                                <div class="text-muted fs-6">@_localizer["SelectLanguageDescription"]</div>
                            </div>

                            <!-- Language Selection Options -->
                            <div class="row g-6 g-xl-9">

                                <!-- English Card -->
                                <div class="col-md-6 col-lg-5 col-xl-4">
                                    <a href="?culture=en" class="card card-dashed h-xl-100 flex-row flex-stack p-6 text-decoration-none border-hover-primary @(currentCulture == "en" ? "border-primary bg-light-primary" : "")">
                                        <div class="d-flex align-items-center me-2">
                                            <div class="symbol symbol-40px me-4">
                                                <span class="symbol-label bg-light-primary text-primary fw-bold">EN</span>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <span class="fs-5 fw-bold text-gray-900">English</span>
                                                <span class="fs-7 text-muted">United States / Global</span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            @if (currentCulture == "en")
                                            {
                                                <span class="badge badge-light-primary fw-bold px-3 py-2">
                                                    <i class="ki-duotone ki-check fs-6 me-1 text-primary"></i> @_localizer["Active"]
                                                </span>
                                            }
                                        </div>
                                    </a>
                                </div>

                                <!-- Persian Card -->
                                <div class="col-md-6 col-lg-5 col-xl-4">
                                    <a href="?culture=fa" class="card card-dashed h-xl-100 flex-row flex-stack p-6 text-decoration-none border-hover-primary @(currentCulture == "fa" ? "border-primary bg-light-primary" : "")">
                                        <div class="d-flex align-items-center me-2">
                                            <div class="symbol symbol-40px me-4">
                                                <span class="symbol-label bg-light-info text-info fw-bold">FA</span>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <span class="fs-5 fw-bold text-gray-900">فارسی</span>
                                                <span class="fs-7 text-muted">Persian / Iran</span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            @if (currentCulture == "fa")
                                            {
                                                <span class="badge badge-light-primary fw-bold px-3 py-2">
                                                    <i class="ki-duotone ki-check fs-6 me-1 text-primary"></i> @_localizer["Active"]
                                                </span>
                                            }
                                        </div>
                                    </a>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>