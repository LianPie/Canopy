@model Canopy.Models.ChatRoomViewModel
@using Microsoft.AspNetCore.Mvc.Localization


@inject IViewLocalizer _localizer
<style>
    /* ── Light mode ───────────────────────── */
    .chatroom-container {
        --chat-bg: #eae6de;
        --chat-header-border: #e5e5ea;
        --chat-bubble-own-bg: #50c070;
        --chat-bubble-own-text: #ffffff;
        --chat-bubble-other-bg: #f5f2e7;
        --chat-bubble-other-text: #595445;
        --chat-sender-name-color: #8e8e93;
        --chat-meta-color: #8e8e93;
        --chat-date-divider-color: #8e8e93;
        --chat-input-bg: #f9f9f9;
        --chat-input-border: #d1d1d6;
        --chat-input-border-focus: #63a343;
        --chat-input-text: #545043;
        --chat-input-placeholder: #8e8e93;
        --chat-icon-color: #8e8e93;
        --chat-icon-hover-bg: #f5f2e7;
    }

    /* ── Dark mode ──────────────────────────────────── */
    [data-bs-theme="dark"] .chatroom-container {
        --chat-bg: #33302f;
        --chat-header-border: #2c2c2e;
        --chat-bubble-own-bg: #75bb7b;
        --chat-bubble-own-text: #504b3a;
        --chat-bubble-other-bg: #4b4645;
        --chat-bubble-other-text: #ffffff;
        --chat-sender-name-color: #8e8e93;
        --chat-meta-color: #8e8e93;
        --chat-date-divider-color: #8e8e93;
        --chat-input-bg: #3a3736;
        --chat-input-border: #38383a;
        --chat-input-border-focus: #63a343;
        --chat-input-text: #ffffff;
        --chat-input-placeholder: #8e8e93;
        --chat-icon-color: #8e8e93;
        --chat-icon-hover-bg: #2b2625;
    }

    /* ── Layout & Containers ───────────────────────── */
    .chatroom-container {
        display: flex;
        flex-direction: column-reverse;
        height: 100%;
        max-height: 100vh;
        min-height: 0;
        background: var(--chat-bg);
        overflow: hidden;
    }

    .chatroom-messages {
        display: flex !important;
        flex-direction: column !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        padding: 16px;
    }

    .chat-date-divider {
        text-align: center;
        color: var(--chat-date-divider-color);
        font-size: 0.8rem;
        margin: 12px 0;
    }

    /* ── Input Bar ───────────────────────── */
    .chatroom-input-bar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-top: 1px solid var(--chat-header-border);
        background: var(--chat-bg);
    }

    .chat-icon-btn {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: transparent;
        color: var(--chat-icon-color);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s ease;
    }

        .chat-icon-btn:hover {
            background: var(--chat-icon-hover-bg);
        }

    .chat-input {
        flex: 1 1 0;
        min-width: 0;
        border: 1px solid var(--chat-input-border);
        border-radius: 20px;
        padding: 9px 16px;
        font-size: 0.95rem;
        outline: none;
        background: var(--chat-input-bg);
        color: var(--chat-input-text);
        transition: border-color 0.15s ease;
    }

        .chat-input::placeholder {
            color: var(--chat-input-placeholder);
        }

        .chat-input:focus {
            border-color: var(--chat-input-border-focus);
        }

    /* ── Unified Bubble & Avatar Layout ───────────────────────── */
    .chat-bubble-row {
        direction: ltr !important;
        display: flex !important;
        align-items: flex-end;
        gap: 8px;
        max-width: 75%;
        width: fit-content;
        margin-bottom: 22px; /* Space for timestamp underneath */
        position: relative;
    }

        /* Messages from other users (Left aligned) */
        .chat-bubble-row.other {
            flex-direction: row !important;
            align-self: flex-start !important;
            margin-right: auto !important;
            margin-left: 0 !important;
        }

        /* Messages from current user (Right aligned) */
        .chat-bubble-row.own {
            flex-direction: row-reverse !important;
            align-self: flex-end !important;
            margin-left: auto !important;
            margin-right: 0 !important;
        }

    /* Avatar Container & Image */
    .chat-avatar-wrapper {
        flex-shrink: 0;
        display: flex;
        align-items: flex-end;
    }

    .chat-pfp {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
    }

    /* Content Wrapper (Sender Name + Bubble + Meta) */
    .chat-content-wrapper {
        display: flex;
        flex-direction: column;
        position: relative;
        max-width: 100%;
    }

    .chat-bubble-row.own .chat-content-wrapper {
        align-items: flex-end;
    }

    .chat-bubble-row.other .chat-content-wrapper {
        align-items: flex-start;
    }

    .chat-sender-name {
        font-size: 0.72rem;
        color: var(--chat-sender-name-color);
        margin-bottom: 2px;
        padding: 0 4px;
    }

    .chat-bubble {
        position: relative;
        padding: 10px 16px;
        border-radius: 20px;
        font-size: 0.95rem;
        line-height: 1.4;
        word-break: break-word;
    }

    /* Own Bubble Styling & Tail */
    .chat-bubble-row.own .chat-bubble {
        background: var(--chat-bubble-own-bg);
        color: var(--chat-bubble-own-text);
        border-bottom-right-radius: 2px;
        border-bottom-left-radius: 20px;
    }

        .chat-bubble-row.own .chat-bubble::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: -6px;
            width: 16px;
            height: 16px;
            background: var(--chat-bubble-own-bg);
            border-bottom-left-radius: 14px;
            clip-path: polygon(100% 0, 0% 100%, 100% 100%);
        }

    /* Other Bubble Styling & Tail */
    .chat-bubble-row.other .chat-bubble {
        background: var(--chat-bubble-other-bg);
        color: var(--chat-bubble-other-text);
        border-bottom-left-radius: 2px;
        border-bottom-right-radius: 20px;
    }

        .chat-bubble-row.other .chat-bubble::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: -6px;
            width: 16px;
            height: 16px;
            background: var(--chat-bubble-other-bg);
            border-bottom-right-radius: 14px;
            clip-path: polygon(0 0, 0% 100%, 100% 100%);
        }

    /* Timestamp & Meta */
    .chat-bubble-meta {
        position: absolute;
        bottom: -18px;
        font-size: 0.68rem;
        color: var(--chat-meta-color);
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
        pointer-events: none;
    }

    .chat-bubble-row.own .chat-bubble-meta {
        right: 4px;
        left: auto;
    }

    .chat-bubble-row.other .chat-bubble-meta {
        left: 4px;
        right: auto;
    }

    .chat-delivered {
        font-size: 0.75rem;
        font-weight: bold;
        color: var(--chat-meta-color);
        margin-left: 2px;
        letter-spacing: -2px;
        display: inline-block;
    }
    /* ── Textarea Wrapper & Inline Actions ───────────────────────── */
    .chat-input-wrapper {
        position: relative;
        flex-grow: 1;
        display: flex;
        align-items: center;
    }

    /* Adjust textarea padding to make room for inside button & counter */
    .chat-input {
        width: 100%;
        resize: none;
        overflow-y: auto;
        max-height: 120px;
        padding-right: 78px !important; /* Extra right padding so text doesn't overlap button */
        border-radius: 20px;
    }

    /* RTL layout padding adjustment */
    [dir="rtl"] .chat-input {
        padding-right: 16px !important;
        padding-left: 78px !important;
    }

    /* Absolute action container inside the textbox */
    .chat-input-actions {
        position: absolute;
        right: 6px;
        bottom: 5px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    [dir="rtl"] .chat-input-actions {
        right: auto;
        left: 6px;
    }

    /* Embedded Send Button */
    .chat-send-inside-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: var(--chat-bubble-own-bg, #50c070);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: opacity 0.15s ease, transform 0.15s ease;
    }

        .chat-send-inside-btn.disabled,
        .chat-send-inside-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            background: var(--chat-icon-color, #8e8e93);
        }

    /* Compact Character Counter (Mobile Friendly) */
    .chat-char-counter {
        font-size: 0.7rem;
        color: var(--chat-meta-color, #8e8e93);
        user-select: none;
        line-height: 1;
    }

    /* Mobile responsive sizing */
    @@media (max-width: 576px) {
        .chat-char-counter {
            font-size: 0.62rem; /* Shrunk on mobile screens */
            opacity: 0.8;
        }

        .chat-send-inside-btn {
            width: 28px;
            height: 28px;
        }

        .chat-input {
            padding-right: 68px !important;
            font-size: 0.88rem;
        }

        [dir="rtl"] .chat-input {
            padding-left: 68px !important;
        }
    }
</style>
<div class="chatroom-container"
     data-chat-id="@Model.ChatId"
     data-group-id="@Model.GroupId"
     data-current-user-id="@Model.CurrentUserId">

    <div class="chatroom-input-bar">
        <button type="button" class="chat-icon-btn" id="chatAttachBtn" title="@_localizer["Attach"]">
            <i class="ki-outline ki-plus fs-3"></i>
        </button>

        <!-- Textarea Wrapper containing Input + Counter + Send Button -->
        <div class="chat-input-wrapper">
            <textarea id="chatMessageInput"
                      class="chat-input"
                      placeholder="@_localizer["Message"]"
                      maxlength="1000"
                      rows="1"></textarea>

            <!-- Inline Actions Inside Textbox -->
            <div class="chat-input-actions">
                <span id="chatCharCounter" class="chat-char-counter">0/1000</span>
                <button type="button" class="chat-send-inside-btn disabled" id="chatSendBtn" title="@_localizer["Send"]" disabled>
                    <i class="ki-outline ki-send fs-4"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="chatroom-messages" id="chatMessages">
        @{
            DateTime? lastDate = null;
            var today = DateTime.Today;
        }

        @foreach (var msg in Model.Messages)
        {
            var msgDate = msg.DateCreated.Date;

            @if (lastDate == null || lastDate != msgDate)
            {
                var dateText = msgDate == today
                    ? _localizer["Today"].Value
                    : msgDate.ToString("yyyy/MM/dd"); // or msgDate.ToString("d") for localized short date

                <div class="chat-date-divider" data-date="@msgDate.ToString("yyyy-MM-dd")">
                    <span>@dateText</span>
                </div>

                lastDate = msgDate;
            }

            var isOwn = msg.UserId == Model.CurrentUserId;

            // Fallback to "0" if user has no image
            var pfpName = !string.IsNullOrEmpty(msg.ImageUrl) ? msg.ImageUrl : "0";

            <div class="chat-bubble-row @(isOwn ? "own" : "other")" data-message-id="@msg.Id">
                <div class="chat-avatar-wrapper">
                    <img src="~/pfp/@(pfpName).jpg" class="chat-pfp" alt="@msg.UserName" />
                </div>
                <div class="chat-content-wrapper">
                    @if (!isOwn)
                    {
                        <div class="chat-sender-name">@msg.UserName</div>
                    }
                    <div class="chat-bubble">
                        <span class="chat-bubble-text">@msg.Text</span>
                    </div>
                    <div class="chat-bubble-meta">
                        @msg.DateCreated.ToString("HH:mm")
                        @if (isOwn)
                        {
                            <span class="chat-delivered" title="@_localizer["Delivered"]">✓✓</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script>
    let chatConnectionReady = null; // پرامیس اتصال، برای هماهنگی با join
    $(function () {
        let attachClickCount = 0;

        $('#chatAttachBtn').on('click', function (e) {
            e.preventDefault();
            attachClickCount++;

            // Trigger modal on the second click and onwards
            if (attachClickCount > 1) {
                var modalEl = document.getElementById('workingOnItModal');
                var modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                modalInstance.show();
            }
        });
    });
    function initChatRoom() {
        const $container = $('.chatroom-container');
        const chatId = parseInt($container.data('chat-id'));
        const currentUserId = parseInt($container.data('current-user-id'));

        scrollMessagesToBottom();

        if (!chatConnection) {
            chatConnection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/chat')
                .withAutomaticReconnect()
                .build();

            chatConnection.on('ReceiveMessage', function (msg) {
                console.log('ReceiveMessage fired:', msg);
                const openChatId = parseInt($('.chatroom-container').data('chat-id'));
                if ((msg.chatId || msg.ChatId) === openChatId) {
                    appendMessage(msg, currentUserId);
                    scrollMessagesToBottom();
                } else {
                    console.log('chatId mismatch — msg for', msg.chatId || msg.ChatId, 'but open chat is', openChatId);
                }
            });

            chatConnection.on('Error', function (message) {
                console.error('Chat error:', message);
            });

            chatConnection.onreconnected(function () {
                chatConnection.invoke('JoinChat', chatId).catch(err => console.error(err));
            });

            chatConnectionReady = chatConnection.start()
                .catch(err => console.error('SignalR connection failed:', err));
        }

        // مهم‌ترین خط: هر بار تب چت باز می‌شه، صریح join کن
        chatConnectionReady.then(function () {
            chatConnection.invoke('JoinChat', chatId).catch(err => console.error('Join failed:', err));
        });

        $('#chatSendBtn, .chat-icon-btn#chatMicBtn').off('click');

        const maxChars = 1000;
        // Input state handler: Adjust height, toggle Send button, update counter
        $('#chatMessageInput').on('input', function () {
            const text = $(this).val();
            const length = text.trim().length;

            // Auto-expand textarea height up to its max-height
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';

            // Update character limit display
            $('#chatCharCounter').text(`${text.length}/${maxChars}`);

            // Enable/Disable Send Button based on non-whitespace content
            if (length > 0) {
                $('#chatSendBtn').prop('disabled', false).removeClass('disabled');
            } else {
                $('#chatSendBtn').prop('disabled', true).addClass('disabled');
            }
        });

        // Keydown handler: Enter sends, Shift+Enter creates a new line
        $('#chatMessageInput').on('keydown', function (e) {
            if (e.which === 13 && !e.shiftKey) {
                e.preventDefault(); // Prevent default newline insertion

                if ($(this).val().trim().length > 0) {
                    triggerSend();
                }
            }
        });

        // Send Button Click
        $('#chatSendBtn').on('click', function () {
            if ($('#chatMessageInput').val().trim().length > 0) {
                triggerSend();
            }
        });
        // Helper function to dispatch message and reset input controls
        function triggerSend() {
            sendChatMessage(chatId);

            // Reset textarea state
            const $input = $('#chatMessageInput');
            $input.val('').css('height', 'auto');
            $('#chatCharCounter').text(`0/${maxChars}`);
            $('#chatSendBtn').prop('disabled', true).addClass('disabled');
        }
    }


    


    function sendChatMessage(chatId) {
        const $input = $('#chatMessageInput');
        const text = $input.val().trim();
        if (!text) return;

        
     chatConnection.invoke('SendMessage', chatId, text)
         .then(() => {
             console.log('SendMessage succeeded for chatId:', chatId);
             $input.val('');
         })
         .catch(err => console.error('Send failed:', err));
    }

      // Initialize last render date from existing DOM dividers, or default to null
    let lastRenderedDateString = $('#chatMessages .chat-date-divider').last().data('date') || null;

    function appendMessage(msg, currentUserId) {
        const isOwn = (msg.userId || msg.UserId) === currentUserId;
        const text = msg.text || msg.Text;
        const senderName = msg.userName || msg.UserName;

        const pfp = (msg.imageUrl || msg.ImageUrl || msg.userPfp || msg.UserPfp) || '0';
        const avatarUrl = `/pfp/${pfp}.jpg`;

        const msgDateObj = new Date(msg.dateCreated || msg.DateCreated);

        // Formatters
        const time = msgDateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
        const dateKey = msgDateObj.toISOString().split('T')[0]; // "YYYY-MM-DD"

        // Insert date divider if message date changed
        if (lastRenderedDateString !== dateKey) {
            const todayKey = new Date().toISOString().split('T')[0];

            let labelText = msgDateObj.toLocaleDateString();
            if (dateKey === todayKey) {
                labelText = '@_localizer["Now"]';
            }

            const dividerHtml = `
                <div class="chat-date-divider" data-date="${dateKey}">
                    <span>${labelText}</span>
                </div>`;

            $('#chatMessages').append(dividerHtml);
            lastRenderedDateString = dateKey;
        }

        const safeText = $('<div>').text(text).html();

       const html = `
        <div class="chat-bubble-row ${isOwn ? 'own' : 'other'}" data-message-id="${msg.id || msg.Id}">
            <div class="chat-avatar-wrapper">
                <img src="${avatarUrl}" class="chat-pfp" alt="${senderName}" />
            </div>
            <div class="chat-content-wrapper">
                ${!isOwn ? `<div class="chat-sender-name">${senderName}</div>` : ''}
                <div class="chat-bubble"><span class="chat-bubble-text">${safeText}</span></div>
                <div class="chat-bubble-meta">
                    ${time}
                    ${isOwn ? '<span class="chat-delivered" title="@_localizer["Delivered"]">✓✓</span>' : ''}
                </div>
            </div>
        </div>`;

        $('#chatMessages').append(html);
    }

    function scrollMessagesToBottom() {
        const $box = $('#chatMessages');
        if ($box.length) $box.scrollTop($box[0].scrollHeight);
    }
</script>