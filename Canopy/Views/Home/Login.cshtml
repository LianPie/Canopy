@namespace Canopy.Resources
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization

@inject IViewLocalizer V
@inject IHtmlLocalizer<SharedResources> SR

@section Head
{
    <link href="~/css/loginstyle.css" rel="stylesheet" />

    <style>
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 8px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .login-btn.loading {
            opacity: 0.7;
            cursor: not-allowed;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Backdrop Overlay */
        .custom-modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5); /* Dim background */
            z-index: 99999;
        }

            /* Display modal when active */
            .custom-modal-backdrop.show {
                display: block;
            }

        /* Modal Card Box - Forced Dead-Center */
        .custom-modal-card {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%); /* Locks perfectly into the screen center */

            background: #d4d4d4;
            color: #555555;
            width: 90%;
            max-width: 360px;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            text-align: center;
            box-sizing: border-box;
            font-family: inherit;
        }

        /* Close Button (X) */
        .custom-modal-close {
            position: absolute;
            top: 10px;
            right: 15px;
            background: none;
            border: none;
            font-size: 24px;
            color: #888888;
            cursor: pointer;
            line-height: 1;
        }

            .custom-modal-close:hover {
                color: #000000;
            }

        /* Modal Contents */
        .custom-modal-img {
            max-width: 100%;
            height: auto;
            max-height: 130px;
            border-radius: 8px;
            margin-bottom: 15px;
            object-fit: cover;
        }

        .custom-modal-title {
            margin: 0 0 8px 0;
            font-size: 18px;
            font-weight: 600;
            color: #181c32;
        }

        .custom-modal-text {
            margin: 0;
            font-size: 14px;
            color: #5e6278;
            line-height: 1.5;
        }
    </style>
}

<div class="login-container">
    <div class="login-card">
        <div class="avatar-container">
            <div class="avatar-circle">
                <i class="fa-solid fa-leaf"></i>

            </div>
        </div>
        @Html.AntiForgeryToken()
        <div class="input-group">
            <div class="input-box">
                <i class="fa-solid fa-user"></i>
                <input type="text" id="username" placeholder="@V["11_LoginUname"]">
            </div>
            <div class="input-box">
                <i class="fa-solid fa-lock"></i>
                <input type="password" id="passwordField" placeholder="@V["12_LoginPass"]">
                <button type="button" id="togglePassword" class="toggle-btn" title="Show/Hide Password">
                    <i class="fa-solid fa-eye-slash" id="lockIcon"></i>
                </button>
            </div>
        </div>

        <div class="options">
            <label class="checkbox-wrapper">
                <input type="checkbox" id="RememberMe">
                <div class="checkmark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M20 6L9 17L4 12" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        </path>
                    </svg>
                </div>
                <span class="label">@V["13_RememberMe"]</span>


            </label>
            <a href="#" id="forgotPasswordBtn">@V["14_ForgotPassword"]</a>
        </div>

        <button class="login-btn" id="loginBtn">@SR["LoginBtn"]</button>
        <p class="switch-mode">@V["15_NoAccount"]<a href="~/home/Signup"> @V["16_SignUp"] </a></p>
    </div>
</div>
<!-- Forgot Password Modal -->
<div id="forgotPasswordModal" class="custom-modal-backdrop">
    <div class="custom-modal-card">
        <button type="button" class="custom-modal-close" id="closeForgotPasswordModal">&times;</button>
        <div class="custom-modal-body">
            <img src="~/img/working on it.png" id="workingOnItImg" class="img-fluid rounded-3 object-fit-cover" style="max-height: 140px;" alt="Working on it" />
        </div>
        <h3 class="fw-bold mb-2 text-gray-900">@V["WorkingOnItTitle"]</h3>
        <p class="text-muted fs-7 mb-0">@V["WorkingOnIt"]</p>
    </div>
</div>

@section Scripts {
    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const passwordField = document.querySelector('#passwordField');
        const lockIcon = document.querySelector('#lockIcon');

        togglePassword.addEventListener('click', function () {
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);

            if (type === 'text') {
                lockIcon.classList.remove('fa-eye-slash');
                lockIcon.classList.add('fa-eye');
                this.classList.add('is-visible');
            } else {
                lockIcon.classList.remove('fa-eye');
                lockIcon.classList.add('fa-eye-slash');
                this.classList.remove('is-visible');
            }
        });
        
        // $(document).ready(function () {
        //     // Open Modal
        //     $(document).off('click', '#forgotPasswordBtn').on('click', '#forgotPasswordBtn', function (e) {
        //         e.preventDefault();
        //         $('#forgotPasswordModal').addClass('show');
        //     });

        //     // Close Modal on 'X' click
        //     $(document).off('click', '#closeForgotPasswordModal').on('click', '#closeForgotPasswordModal', function () {
        //         $('#forgotPasswordModal').removeClass('show');
        //     });

        //     // Close Modal when clicking outside the white card
        //     $(document).off('click', '#forgotPasswordModal').on('click', '#forgotPasswordModal', function (e) {
        //         if ($(e.target).is('#forgotPasswordModal')) {
        //             $('#forgotPasswordModal').removeClass('show');
        //         }
        //     });
        // });

        const vmessages = {
            requiredFields: '@V["RequiredFields"]',
            error400: '@V["Error400"]',
            error403: '@V["Error403"]',
            error500: '@V["Error500"]',
            errorGeneric: '@V["ErrorGeneric"]',
            InvalidCred: '@V["17_InvalidCred"]',
        };

        $(document).ready(function() {
            $('#loginBtn').click(function(e) {
                e.preventDefault();

                const loginData = {
                    Username: $('#username').val(),
                    Password: $('#passwordField').val(),
                    RememberMe: $('#RememberMe').is(':checked')
                };

                if (!loginData.Username || !loginData.Password) {
                    toastr.warning(vmessages.requiredFields);
                    return;
                }

                const $btn = $(this);
                const originalText = $btn.text();
                $btn.html('<span class="loading-spinner"></span> Logging in...').addClass('loading').prop('disabled', true);
               let token= $("input[name='__RequestVerificationToken']").val()
                $.ajax({
                    url: '/Home/Login',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(loginData),
                       headers: {
                        'RequestVerificationToken': token
                        },
                    xhrFields: {
                        withCredentials: true
                    },
                        success: function(response) {
                            toastr.success(response.message.value);
                        setTimeout(function() {
                            window.location.href = '/dashboard';
                        }, 1500);
                    },
                    error: function(xhr) {
                        $btn.html(originalText).removeClass('loading').prop('disabled', false);

                        if (xhr.status === 401) {
                            if (xhr.responseJSON) {
                                if (xhr.responseJSON.errors) {
                                    $.each(xhr.responseJSON.errors, function(field, messages) {
                                        toastr.error(messages[0]);
                                    });
                                }
                                else if (xhr.responseJSON.message) {
                                    toastr.error(xhr.responseJSON.message);
                                }
                                else {
                                    toastr.error(vmessages.InvalidCred);
                                }
                            } else {
                                toastr.error(vmessages.InvalidCred);
                            }
                        }
                        else if (xhr.status === 400) {
                            const response = xhr.responseJSON;
                            if (response && response.errors) {
                                $.each(response.errors, function(field, messages) {
                                    toastr.error(messages[0]);
                                });
                            } else if (response && response.message) {
                                toastr.error(response.message);
                            } else {
                                toastr.error(vmessages.error400);
                            }
                        }
                        else if (xhr.status === 403) {
                            const response = xhr.responseJSON;
                            if (response && response.message) {
                                toastr.error(response.message);
                            } else {
                                toastr.error(vmessages.error403);
                            }
                        }
                        else if (xhr.status === 500) {
                            toastr.error(vmessages.error500);
                        }
                        else {
                            toastr.error(vmessages.errorGeneric);
                        }
                    }
                });
            });
        });

        $(document).ready(function () {

            $('#forgotPasswordBtn').on('click', function (e) {
                e.preventDefault();

                var inputVal = $('#username').val().trim();
                var token = $('input[name="__RequestVerificationToken"]').val();

                // 1. Validation: Ensure user entered their email or username first
                if (!inputVal) {
                    var emptyMsg = "@V["EnterLoginUname"]";

                    // Highlight input and show toastr error
                    $('#username').focus().addClass('input-error');
                    toastr.error(emptyMsg);
                    return;
                }

                $('#username').removeClass('input-error');

                // 2. Submit request to ForgotPassword endpoint
                $.ajax({
                    url: '/Home/ForgotPassword',
                    type: 'POST',
                    data: {
                        email: inputVal,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res && res.redirectUrl) {
                            window.location.href = res.redirectUrl;
                        } else {
                            window.location.href = '/Home/VerifyEmail?email=' + encodeURIComponent(inputVal);
                        }
                    },
                    error: function (xhr) {
                        var res = xhr.responseJSON;
                        var errorMsg = serverErrorMessages["UnexpectedError"] || "An error occurred.";

                        if (res) {
                            var rawKey = (res.code && res.code.length > 0) ? res.code[0] :
                                         (res.general && res.general.length > 0) ? res.general[0] : null;

                            if (rawKey && serverErrorMessages[rawKey]) {
                                errorMsg = serverErrorMessages[rawKey];
                            }
                        }

                        toastr.error(errorMsg);
                    }
                });
            });

        });
    </script>

}
